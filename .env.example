# =========================================================
# Variables publicas (van en .env.local Y en Vercel)
# Se exponen al navegador: NUNCA poner secretos aca.
# =========================================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-anon-o-publishable-key

# Clave publica VAPID para Web Push (se genera con scripts/generate-vapid-keys.mjs)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# =========================================================
# Variables SOLO de servidor (van en Vercel como "server-only",
# nunca en NEXT_PUBLIC_*, nunca commiteadas)
# =========================================================
# Service role de Supabase: solo se usa en Route Handlers del servidor
# (vincular invitaciones de cuidador por email, tareas administrativas).
SUPABASE_SERVICE_ROLE_KEY=

# Clave privada VAPID, para firmar los envios de Web Push desde el servidor.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@tudominio.com

# Protege /api/cron/reminders para que solo Vercel Cron (u otro llamador
# autorizado) pueda dispararlo. Generá un valor aleatorio largo.
CRON_SECRET=
